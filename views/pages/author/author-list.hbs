<h1>{{ title }}</h1>

<!-- Optional Search Form for Authors -->
<form class="search-form" method="GET" action="/authors">
  <input 
    type="text" 
    name="query" 
    class="search-input" 
    placeholder="Cerca autore per nome..." 
    value="{{query}}"
  >
  <button type="submit" class="btn btn-primary">Cerca</button>
</form>

{{#if authors.length}}
  <ul class="item-list">
    {{#each authors}}
      <li class="item-card row">
        <div>
          <h2 class="mt-0 mb-0-25">
            <a href="/authors/{{this.id}}">{{this.name}}</a>
          </h2>
          <p class="meta m-0">
            Libri scritti: {{this.books.length}}
          </p>
        </div>
        <a href="/authors/{{this.id}}" class="btn btn-primary btn-sm">Dettagli</a>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="meta">Nessun autore trovato.</p>
{{/if}}
