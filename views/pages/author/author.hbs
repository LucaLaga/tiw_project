<div class="actions">
  <a href="/authors" class="btn btn-primary">&larr; Torna agli Autori</a>
</div>

<div class="form-card max-w-100">
  <h1 class="m-0 text-primary">{{author.name}}</h1>
</div>

<h2>Libri di {{author.name}}</h2>

{{#if author.books.length}}
  <ul class="item-list">
    {{#each author.books}}
      <li class="item-card">
        <strong><a href="/books/{{this.id}}">{{this.title}}</a></strong>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="meta">Nessun libro trovato per questo autore.</p>
{{/if}}
