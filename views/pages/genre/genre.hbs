<div class="actions">
  <a href="/genres" class="btn btn-primary">&larr; Torna ai Generi</a>
</div>

<div class="form-card max-w-100">
  <h1 class="m-0 text-primary">{{genre.name}}</h1>
</div>

<h2>Libri nel genere: {{genre.name}}</h2>

{{#if genre.books.length}}
  <ul class="item-list">
    {{#each genre.books}}
      <li class="item-card">
        <strong><a href="/books/{{this.id}}">{{this.title}}</a></strong>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="meta">Nessun libro trovato per questo genere.</p>
{{/if}}
