<div class="actions" style="margin-bottom: 1.5rem;">
  <a href="/genres" class="button-link">&larr; Torna ai Generi</a>
</div>

<div class="form-card" style="max-width: 100%; margin-bottom: 2rem;">
  <h1 style="margin: 0; color: var(--primary);">{{genre.name}}</h1>
</div>

<h2 style="margin-bottom: 1rem;">Libri nel genere: {{genre.name}}</h2>

{{#if genre.books.length}}
  <ul class="book-list">
    {{#each genre.books}}
      <li class="book-card">
        <strong><a href="/books/{{this.id}}">{{this.title}}</a></strong>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="meta">Nessun libro trovato per questo genere.</p>
{{/if}}

