<h1>{{ title }}</h1>

<!-- Optional Search Form for Genres -->
<form class="search-form" method="GET" action="/genres">
  <input 
    type="text" 
    name="query" 
    class="search-input" 
    placeholder="Cerca genere per nome..." 
    value="{{query}}"
  >
  <button type="submit" class="btn btn-primary">Cerca</button>
</form>

{{#if genres.length}}
  <ul class="item-list mt-1-5">
    {{#each genres}}
      <li class="item-card row">
        <div>
          <h2 class="mt-0 mb-0-25">
            <a href="/genres/{{this.id}}">{{this.name}}</a>
          </h2>
          <p class="meta m-0">
            Libri nel genere: {{this.books.length}}
          </p>
        </div>
        <a href="/genres/{{this.id}}" class="btn btn-primary btn-sm">Esplora</a>
      </li>
    {{/each}}
  </ul>

  <div class="pagination mt-1-5">
    {{#if (gt currentPage 1)}}
      <a href="?page={{subtract currentPage 1}}&query={{query}}" class="btn btn-secondary btn-sm">Previous</a>
    {{else}}
      <span class="btn btn-secondary btn-sm" style="opacity: 0.5; cursor: not-allowed;">Previous</span>
    {{/if}}
    <span class="page-info">Page {{currentPage}}</span>
    {{#if hasNextPage}}
      <a href="?page={{add currentPage 1}}&query={{query}}" class="btn btn-secondary btn-sm">Next</a>
    {{else}}
      <span class="btn btn-secondary btn-sm" style="opacity: 0.5; cursor: not-allowed;">Next</span>
    {{/if}}
  </div>
{{else}}
  <p class="meta">Nessun genere trovato.</p>
{{/if}}
