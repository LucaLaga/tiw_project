<div class="actions">
  <a href="javascript:history.back()" class="button-link">&larr; Torna ai Prestiti</a>
</div>

{{#if loan}}
  <article class="form-card max-w-100">
    <h1 class="mt-0 text-primary">
      Dettaglio Prestito #{{loan.id}}
    </h1>

    <table class="reg-table">
      <tbody>
        <tr>
          <th>Libro</th>
          <td>
            <a href="/books/{{loan.book.id}}"><strong>{{loan.book.title}}</strong></a> 
            <br><span class="meta">ISBN: {{loan.book.isbn}}</span>
          </td>
        </tr>
        <tr>
          <th>Utente</th>
          <td>
            {{loan.user.name}} 
            <br><span class="meta">{{loan.user.email}}</span>
          </td>
        </tr>
        <tr>
          <th>Data Prestito</th>
          <td>{{loan.borrowed_at}}</td>
        </tr>
        <tr>
          <th>Data Restituzione</th>
          <td>
            {{#if loan.returned_at}}
              {{loan.returned_at}}
            {{else}}
              <span class="out-of-stock status-warning">Attualmente in corso</span>
            {{/if}}
          </td>
        </tr>
      </tbody>
    </table>

    {{#unless loan.returned_at}}
      {{#if (eq currentUser.role "organizer")}}
        <div class="actions mt-1-5 justify-start">
          <form method="POST" action="/loans/{{loan.id}}/return" class="inline-form">
            <button type="submit" class="btn btn-secondary">Registra Restituzione</button>
          </form>
        </div>
      {{/if}}
    {{/unless}}

  </article>
{{else}}
  <div class="error-page">
    <h1>Prestito non trovato</h1>
    <p>Il prestito che stai cercando non esiste.</p>
    <a href="/loans/personal" class="btn btn-primary">Torna ai Prestiti</a>
  </div>
{{/if}}
