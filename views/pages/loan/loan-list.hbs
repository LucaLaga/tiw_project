<h1>{{title}}</h1>

{{#if loans.length}}
  <ul class="item-list">
    {{#each loans}}
      <li class="item-card row">
        <div>
          <h2 class="mt-0 mb-0-25">
            <!-- Assuming a route for loan details exists -->
            <a href="/loans/{{this.id}}">{{this.book.title}}</a>
          </h2>
          
          {{#if (eq ../currentUser.role "organizer")}}
            <p class="meta mt-0 mb-0-25">
              <strong>Utente:</strong> {{this.user.name}} ({{this.user.email}})
            </p>
          {{/if}}

          <p class="meta m-0">
            <strong>Data prestito:</strong> {{this.borrowed_at}} <br>
            <strong>Stato:</strong> 
            {{#if this.returned_at}}
              Restituito il {{this.returned_at}}
            {{else}}
              <span class="out-of-stock status-warning">In prestito</span>
            {{/if}}
          </p>
        </div>
        
        <div class="actions">
          <a href="/loans/{{this.id}}" class="btn btn-primary btn-sm">Dettagli</a>
          
          {{#unless this.returned_at}}
              <form method="POST" action="/loans/{{this.id}}/return" class="inline-form ml-0-5">
                <button type="submit" class="btn btn-secondary btn-sm">Restituisci</button>
              </form>
          {{/unless}}
        </div>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="meta">Nessun prestito trovato.</p>
{{/if}}
