<div class="actions">
  <a href="/books/{{book.id}}" class="button-link">&larr; Torna ai Dettagli del Libro</a>
</div>

<article class="form-card">
  <h1 class="mt-0 mb-1-5 no-border">Modifica Libro</h1>

  <form method="POST" action="/books/{{book.id}}/edit">
    
    <div class="form-group">
      <label for="title">Titolo</label>
      <input 
        type="text" 
        id="title" 
        name="title" 
        value="{{book.title}}" 
        required
      >
    </div>

    <div class="form-group">
      <label for="isbn">ISBN</label>
      <input 
        type="text" 
        id="isbn" 
        name="isbn" 
        value="{{book.isbn}}" 
        required
      >
    </div>

    <div class="form-row">
      <div>
        <label for="publication_year">Anno di Pubblicazione</label>
        <input 
          type="number" 
          id="publication_year" 
          name="publication_year" 
          value="{{book.publication_year}}" 
          required
        >
      </div>
      
      <div>
        <label for="pages">Pagine</label>
        <input 
          type="number" 
          id="pages" 
          name="pages" 
          value="{{book.pages}}" 
          required
        >
      </div>
      
      <div>
        <label for="quantity">Quantità Dispo.</label>
        <input 
          type="number" 
          id="quantity" 
          name="quantity" 
          value="{{book.quantity}}" 
          min="0"
          required
        >
      </div>
    </div>

    <div class="form-group mb-1-5">
      <label for="description">Descrizione</label>
      <textarea 
        id="description" 
        name="description" 
        rows="5" 
        required
      >{{book.description}}</textarea>
    </div>

    <div class="actions mt-1-5 justify-start">
      <button type="submit" class="btn btn-primary">Salva Modifiche</button>
      <a href="/books/{{book.id}}" class="btn btn-secondary">Annulla</a>
    </div>

  </form>
</article>
