<div class="actions">
  <a href="/books" class="btn btn-primary">&larr; Torna al Catalogo</a>
</div>

{{#if book}}
  <article class="form-card max-w-100">
    <h1 class="mt-0 no-border">
      {{book.title}} ({{book.publication_year}})
    </h1>
    
    <div class="meta">
      <strong>Autore/i:</strong> 
      {{#each book.authors}}
        {{this.name}}{{#unless @last}}, {{/unless}}
      {{else}}
        <em>Sconosciuto</em>
      {{/each}}
    </div>

    <div class="mb-1-5">
      {{#each book.genres}}
        <span class="badge">{{this.name}}</span>
      {{/each}}
    </div>

    <p>
      {{book.description}}
    </p>

  <h3>Dettagli del Libro</h3>
    <table class="reg-table">
      <tbody>
        <tr>
          <th>ISBN</th>
          <td>{{book.isbn}}</td>
        </tr>
        <tr>
          <th>Pagine</th>
          <td>{{book.pages}}</td>
        </tr>
        <tr>
          <th>Disponibilità</th>
          <td>
            {{#if book.quantity}}
              <span class="stock">{{book.quantity}} copie disponibili</span>
            {{else}}
              <span class="out-of-stock">Esaurito</span>
            {{/if}}
          </td>
        </tr>
      </tbody>
    </table>

    <!-- New Action Buttons -->
    <div class="actions mt-1-5 justify-start">
      {{#if book.quantity}}
        <form method="POST" action="/books/{{book.id}}/borrow" class="inline-form">
          <button type="submit" class="btn btn-primary">Prendi in prestito</button>
        </form>
      {{/if}}
    </div>
    
    {{#if (eq currentUser.role "organizer")}}
      <div class="actions mt-1-5 bordered justify-start">
        <a href="/books/{{book.id}}/edit" class="btn btn-secondary">Modifica</a>

        <form method="POST" action="/books/{{book.id}}/delete" class="inline-form" onsubmit="return confirm('Sei sicuro di voler eliminare questo libro?');">
          <button type="submit" class="btn btn-danger">Elimina</button>
        </form>
      </div>
    {{/if}}
  </article>
{{else}}
  <div class="error-page">
    <h1>Libro non trovato</h1>
    <p>Il libro che stai cercando non esiste o è stato rimosso.</p>
    <a href="/catalog" class="btn btn-primary">Torna al Catalogo</a>
  </div>
{{/if}}
