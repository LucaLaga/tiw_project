<h1>{{ title }}</h1>

<div class="search-container">
  <form method="GET" action="" class="search-form">
    <input
      type="text"
      name="q"
      placeholder="Search by Title or ISBN..."
      value="{{searchQuery}}"
      class="search-input"
    >
    <button type="submit" class="btn btn-primary">Search</button>

    {{#if searchQuery}}
      <a href="?" class="btn btn-secondary">Clear</a>
    {{/if}}
  </form>

  {{#if currentUser}}
    {{#if (eq currentUser.role 'organizer')}}
      <a href="/books/create" class="btn btn-primary">Aggiungi Libro</a>
    {{/if}}
  {{/if}}
</div>

{{#if books.length}}
  <ul class="item-list">
    {{#each books}}
      <li class="item-card">
        <h2><a href="/books/{{this.id}}">{{this.title}} ({{this.publication_year}})</a></h2>
        <p>
          <strong>Author(s):</strong>
          {{#each this.authors}}
            {{this.name}}{{#unless @last}}. {{/unless}}
          {{else}}
            <em>Unknown</em>
          {{/each}}
        </p>

        <div>
          {{#each this.genres}}
            <span class="badge">{{this.name}}</span>
          {{/each}}
        </div>
      </li>
    {{/each}}
  </ul>

  <div class="pagination mt-1-5">
    {{#if (gt currentPage 1)}}
      <a href="?page={{subtract currentPage 1}}&q={{searchQuery}}" class="btn btn-secondary btn-sm">Previous</a>
    {{else}}
      <span class="btn btn-secondary btn-sm" style="opacity: 0.5; cursor: not-allowed;">Previous</span>
    {{/if}}
    <span class="page-info">Page {{currentPage}}</span>
    {{#if hasNextPage}}
      <a href="?page={{add currentPage 1}}&q={{searchQuery}}" class="btn btn-secondary btn-sm">Next</a>
    {{else}}
      <span class="btn btn-secondary btn-sm" style="opacity: 0.5; cursor: not-allowed;">Next</span>
    {{/if}}
  </div>
{{else}}
  <p class="meta">Nessun libro trovato.</p>
{{/if}}
